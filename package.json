{
  "name": "iekei-ramen-mcp",
  "version": "0.1.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "data:fetch": "node scripts/data/fetch-shops.mjs",
    "data:judge": "node --env-file-if-exists=.dev.vars scripts/data/judge-all.mjs",
    "data:dedupe": "node --env-file-if-exists=.dev.vars scripts/data/find-duplicates.mjs",
    "data:rescore": "node scripts/data/rescore.mjs",
    "data:areas": "node scripts/data/fill-areas.mjs",
    "data:geocode": "node scripts/data/geocode-verified.mjs",
    "data:build": "node scripts/data/build-dataset.mjs",
    "reports": "node scripts/dev/reports.mjs",
    "build:ui": "cross-env NODE_ENV=production vite build && node scripts/build/embed-html.mjs && cross-env NODE_ENV=production vite build --mode web && node scripts/build/build-seo.mjs",
    "build": "npm run build:ui && tsc --noEmit",
    "dev": "cross-env NODE_ENV=development npm run build:ui && tsx server/main.ts",
    "dev:worker": "npm run build:ui && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply iekei-ramen-visits --remote",
    "deploy": "npm run build:ui && npm run db:migrate && wrangler deploy",
    "deploy:staging": "node scripts/dev/deploy-staging.mjs",
    "typecheck": "tsc --noEmit",
    "dev:stdio": "tsx server/main.ts --stdio",
    "test:watch": "vitest",
    "e2e:setup": "node scripts/dev/setup-e2e.mjs",
    "e2e": "node scripts/dev/setup-e2e.mjs && playwright test",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "capture": "node scripts/dev/setup-e2e.mjs && playwright test --config=pw-capture.config.ts && node scripts/assets/make-demo-gif.mjs",
    "slides:pdf": "node scripts/assets/make-slides-pdf.mjs",
    "doctor": "react-doctor",
    "prepare": "git config core.hooksPath .githooks || true",
    "usage": "node --env-file-if-exists=.dev.vars scripts/dev/usage.mjs",
    "submission:chatgpt": "rm -f dist/iekei-ramen-chatgpt.zip && mkdir -p dist && cd submission/chatgpt && zip -r -X ../../dist/iekei-ramen-chatgpt.zip plugin.json mcp.json assets"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "maplibre-gl": "^6.15.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "knip": "^6.43.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react-doctor": "^0.9.18",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
