{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iekei-ramen-mcp",
  "main": "server/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/web",
    // 存在しない URL に Web の 404 ページを返すため、Worker から読む（#169）。
    "binding": "ASSETS",
    "not_found_handling": "none",
    // HTMLのナビゲーションでも、MCPと認可の経路を静的ページに置き換えない。
    "run_worker_first": [
      "/mcp",
      "/health",
      "/whereami",
      "/reports",
      "/authorize",
      "/callback/google",
      "/token",
      "/register",
      "/.well-known/*",
      "/map/japan.pmtiles",
    ],
  },
  "observability": { "enabled": true },
  // コードを縮めて上げる（#170。2,720KB → 1,970KB）。source map も上げるので、
  // 本番のスタックトレースは元の名前と行で読める。
  "minify": true,
  "upload_source_maps": true,
  // 本番の URL。**公開した後では変えにくい**（登録されたコネクタ・掲載情報・貼られた
  // リンク・Google サインインの戻り先が全部壊れる）ので、公開前にここへ移した（#41）。
  // ゾーンは同じアカウントの Cloudflare Registrar で取ったもの。
  "routes": [{ "pattern": "iekeiramen.com", "custom_domain": true }],
  // **workers_dev は書かない。** routes があると既定で false になり、旧い入口
  // （workers.dev）は止まる（#41）。false と書くと、README に沿って routes を消した
  // 自前のデプロイでも workers.dev が開かず、URL が 1 つも無くなる。
  // Google の OAuth クライアント ID。**秘密ではない**（認可 URL に平文で載る）。
  // 対になるシークレットは `wrangler secret put GOOGLE_CLIENT_SECRET` で入れる。
  "vars": {
    "GOOGLE_CLIENT_ID": "137432264706-la7kvlrkic3t0h4j6apv30bdvihbt3nm.apps.googleusercontent.com",
  },
  // OAuth の控え（発行したトークン・クライアント登録・付与）。
  // **消えてもスタンプは無事**——サインインし直しになるだけ。
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "06516559e3374d8ea0fef18bf28460c2" }],
  // 訪問スタンプの記録。**利用者のデータなので、消えたら戻らない。**
  "d1_databases": [
    {
      "binding": "VISITS",
      "database_name": "iekei-ramen-visits",
      "database_id": "00f8b2e9-c020-455b-b8ca-4dc67dbbdc01",
    },
  ],
  // 地名検索（Nominatim）の接続元ごとの連打止め。拠点ごとに数えるので、ポリシーの
  // 「全体で 1 秒 1 回」はこれでは守れない（下の GEOCODE_GATE が守る）。
  // 数えるのはキャッシュに無い地名だけ（server/tools/geocode-place.ts）。
  "ratelimits": [
    { "name": "GEOCODE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "REPORT_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
  ],
  // Nominatim へ出ていく問い合わせを、全体で 1 本の列に並べる（server/lib/geocode-gate.ts）。
  // 無料プランで使えるのは SQLite 版だけなので new_sqlite_classes で作る。
  "durable_objects": { "bindings": [{ "name": "GEOCODE_GATE", "class_name": "GeocodeGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GeocodeGate"] }],
  // 使われているかを数える（server/lib/usage.ts）。無料枠は書き込み 1 日 10 万件・
  // 読み取り 1 日 1 万回。書くのは tool 名とサインインの有無だけで、個人は特定しない。
  // 週ごとの件数は `npm run usage`。
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "iekei_ramen_usage" }],
  /*
   * 地図のデータ（日本の範囲の PMTiles、#246）。Worker が /map/japan.pmtiles で範囲指定に答えて返す。
   * **binding は env へ引き継がれない**ので、確認用（staging）にも要るなら env.staging にも書く。
   * 置き方は docs/development/map.md。
   */
  "r2_buckets": [{ "binding": "MAP_TILES", "bucket_name": "iekei-ramen-map" }],
  // 本番の Worker ではプレビュー版（Version URLs）を使わない。Durable Object を持つ Worker には
  // 作られないため（#192。公式: Version URLs are not generated for Workers that implement a Durable Object）。
  // 本番の前に確かめる場所は、下の確認用の環境（staging）。
  "preview_urls": false,
  /*
   * 確認用の環境（#192）。`npm run deploy:staging` で、どのブランチからでも上げる（CI からは上げない）。
   * オーナーがスマホで、本番と同じ https の条件で確かめるための場所。Access（Cloudflare アカウント）で守る。
   *
   * **データベース・KV・Durable Object・Analytics Engine・連打止めは本番と分ける**（確認中に何を押しても
   * 本番のデータと利用回数の数字に触らない）。サインインの秘密の値も本番と共有しない（入れていないので、
   * 確認用ではサインインは動かない）。
   * **routes は空にする。** 書かないと本番の routes（iekeiramen.com）を引き継ぎ、確認用が本番の URL を奪う。
   */
  "env": {
    "staging": {
      "name": "iekei-ramen-staging",
      "routes": [],
      // 初めて作るときだけ false で上げ、オーナーが Access を付けてから true にした（#192）。
      "workers_dev": true,
      "preview_urls": false,
      // サインインの値（GOOGLE_CLIENT_ID）は入れない。確認用ではサインインを動かさない。
      "vars": {},
      "assets": {
        // 確認用は検索エンジンに載せない robots.txt と X-Robots-Tag を足した複製を上げる
        // （scripts/dev/deploy-staging.mjs が作る）。
        "directory": "./dist/staging",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": [
          "/mcp",
          "/health",
          "/whereami",
          "/reports",
          "/authorize",
          "/callback/google",
          "/token",
          "/register",
          "/.well-known/*",
          "/map/japan.pmtiles",
        ],
      },
      // 地図のデータ（#246）。読むだけなので、本番と同じバケットを使う（binding は引き継がれない）。
      "r2_buckets": [{ "binding": "MAP_TILES", "bucket_name": "iekei-ramen-map" }],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d0e99b4c70ec41588a54d33dd8b80a90" }],
      "d1_databases": [
        {
          "binding": "VISITS",
          "database_name": "iekei-ramen-visits-staging",
          "database_id": "c07ba531-2069-4cda-970e-d550f8f0e85a",
        },
      ],
      "ratelimits": [
        {
          "name": "GEOCODE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "REPORT_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "GEOCODE_GATE", "class_name": "GeocodeGate" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GeocodeGate"] }],
      "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "iekei_ramen_usage_staging" }],
    },
  },
}
